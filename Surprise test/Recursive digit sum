long long digitSum(long long n)
{
    if(n < 10)
        return n;

    long long sum = 0;

    while(n > 0)
    {
        sum += n % 10;
        n /= 10;
    }

    return digitSum(sum);
}

int superDigit(string n, int k)
{
    long long sum = 0;

    for(char c : n)
        sum += c - '0';

    sum = sum * k;

    return digitSum(sum);
}
