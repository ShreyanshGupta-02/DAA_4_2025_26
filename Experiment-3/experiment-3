#include <iostream>
#include <vector>
#include <string>
using namespace std;
vector<string> board;
vector<vector<string>> result;
int n;

bool isValid(int x, int y) {
    for (int i=0;i<x;i++) {
        if (board[i][y]=='Q'){
            return false;
        }
    }
    for (int i=x-1,j=y-1;i>=0&&j>=0;i--,j--) {
        if (board[i][j]=='Q'){
            return false;
        }
    }
    for (int i=x-1,j=y+1;i>=0&&j<n;i--,j++) {
        if (board[i][j]=='Q'){
            return false;
        }
    }
    return true;
}
void solve(int row){
    if (row == n){
        result.push_back(board);
        return;
    }
    for(int col=0;col<n;col++){
        if(isValid(row,col)){
            board[row][col]='Q';
            solve(row+1);
            board[row][col]='.';
        }
    }
}
int main(){
    cin >> n;
    board.assign(n,string(n,'.'));
    solve(0);
    cout<<result.size() << endl;
    return 0;
}

time complexity: o(n)
